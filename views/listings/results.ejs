<% layout("/layouts/boilerplate") %>

<body>
    <h1>Filtered Buses</h1>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% if (listings.length === 0) { %>
            <p>No buses found for your filters.</p>
        <% } else { %>
            <% for (let listing of listings) { %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card col listing-card">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem; object-fit: cover;">
                        <div class="card-body">
                            <div class="card-text">
                                <div class="top-row">
                                    <p><b><%= listing.title %></b></p>
                                    <p><%= listing.departureTime %> <%= listing.arrivalTime %></p>
                                </div>
                                <div class="bottom-row">
                                    <p><%= listing.busType %></p>
                                    <p>&#8377;<%= listing.price.toLocaleString("en-IN") %> <i class="tax-info">+18% GST</i></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            <% } %>
        <% } %>
    </div>

    <a href="/listings" class="btn btn-primary mt-3">Back to All Buses</a>
</body>
